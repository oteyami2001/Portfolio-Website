# Optional. Enables live AI answers in the portfolio assistant.
# Without it, the assistant answers from the built-in, grounded FAQ.
ANTHROPIC_API_KEY=

# Public site URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. Public contact email shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
